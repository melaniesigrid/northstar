{
  "name": "northstar",
  "version": "0.1.0",
  "private": true,
  "description": "A quality pipeline for coding agents. Plan, write, check, review, and only then commit. Runs on Codex alone.",
  "type": "module",
  "bin": {
    "northstar": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
